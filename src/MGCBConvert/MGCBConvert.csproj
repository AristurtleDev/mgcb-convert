<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mgcb-convert</ToolCommandName>
    <PackageId>AristurtleDev.Tools.MGCBConvert</PackageId>
    <Version>0.0.2</Version>
    <Authors>Christopher Whitley</Authors>
    <Company>Christopher Whitley</Company>
    <Description>Migration tool to convert legacy .mgcb files to the new MonoGame Content Builder format</Description>
    <PackageTags>monogame;content;migration;mgcb</PackageTags>
    <PackageProjectUrl>https://github.com/AristurtleDev/mgcb-convert</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <RepositoryBranch>develop</RepositoryBranch>
    <RepositoryUrl>https://github.com/AristurtleDev/mgcb-convert</RepositoryUrl>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageIcon>nuget-icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright © 2025 Christopher Whitley and Contributors</Copyright>
  </PropertyGroup>

    <ItemGroup>
        <None Include="../../nuget-icon.png" Pack="true" PackagePath="" />
        <None Include="../../README.md" Pack="true" PackagePath="" />
    </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <PackageReference Include="MonoGame.Framework.DesktopGl" Version="3.8.5-develop.13" />
    <PackageReference Include="MonoGame.Framework.Content.Pipeline" Version="3.8.5-develop.13" />
  </ItemGroup>

</Project>
